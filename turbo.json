{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "DATABASE_URL",
        "PALETTE_DIRECTORY",
        "VERCEL",
        "VERCEL_ENV",
        "VERCEL_GIT_PROVIDER",
        "VERCEL_GIT_COMMIT_SHA",
        "VERCEL_GIT_PREVIOUS_SHA"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:integration": {
      "cache": false
    },
    "palettes:sync": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
